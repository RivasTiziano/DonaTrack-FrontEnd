# ==============================================================================
# DonaTrack Frontend - Variables de Entorno y Configuración
# ==============================================================================
# Copiar este archivo como '.env' para desarrollo local o configurar en el servidor:
#   cp .env.example .env
# ==============================================================================

# Puerto de escucha del Frontend
FRONTEND_PORT=8090

# URLs de los microservicios del Backend
# Desarrollo Local (Docker Compose o standalone):
DONACIONES_API_URL=http://localhost:8080
LOGISTICA_API_URL=http://localhost:8083
INCENTIVOS_API_URL=http://localhost:8082
NOTIFICACIONES_API_URL=http://localhost:8081
AUTENTICACION_API_URL=http://localhost:8084

# Para despliegue en la Nube (Render):
# DONACIONES_API_URL=http://donatrack-donaciones:8080
# LOGISTICA_API_URL=http://donatrack-logistica:8083
# INCENTIVOS_API_URL=http://donatrack-incentivos:8082
# NOTIFICACIONES_API_URL=http://donatrack-notificaciones:8081
# AUTENTICACION_API_URL=http://donatrack-autenticacion:8084
